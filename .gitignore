# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
*.pem

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Data (raw Olist CSVs are large; keep structure, ignore contents except .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Model artifacts (regenerate via notebooks)
models/*
!models/.gitkeep
!models/.gitkeep

# Reports / figures generated at runtime
reports/figures/*
!reports/figures/.gitkeep

# Streamlit
.streamlit/secrets.toml
